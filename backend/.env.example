# Server
PORT=5000

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_DISABLED=false

# LLM provider
# Options: groq (default), gemini
LLM_PROVIDER=groq

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Embeddings provider
# Options: local (default), gemini
EMBEDDING_PROVIDER=local

# Embedding vector dimension (read-only reference; local MiniLM = 384)
EMBEDDING_DIM=384

# Auth
JWT_SECRET=

# Optional retrieval settings
TOP_K=5

# Chat memory settings
CHAT_MEMORY_MESSAGES=8
