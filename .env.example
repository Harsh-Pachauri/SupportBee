# ─── Supabase ────────────────────────────────────────────────────────────────
# Project settings → API → Project URL
SUPABASE_URL=https://your-project.supabase.co

# Project settings → API → service_role key  (never expose client-side)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Set one of: groq | gemini   (default: groq)
LLM_PROVIDER=groq

# Groq  — https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.1-8b-instant

# Gemini — https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.0-flash

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000

# Dashboard origin — lock this down in production
# Leave unset (or *) for local development
# CORS_ORIGIN=https://dashboard.your-domain.com

# ─── Confidence thresholds (optional) ────────────────────────────────────────
# score >= HIGH → "high" confidence   (default: 0.8)
# score >= MEDIUM → "medium" confidence  (default: 0.6)
# score <  MEDIUM → "low" → escalated
# CONFIDENCE_HIGH_THRESHOLD=0.8
# CONFIDENCE_MEDIUM_THRESHOLD=0.6
